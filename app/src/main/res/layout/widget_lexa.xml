<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/widget_title"
        android:textColor="@color/widget_pencil"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:textColor="@color/widget_ink"
        android:textSize="32sp" />

    <!-- The marker: what needs doing now. Shown only while words are waiting. A FrameLayout, because
         RemoteViews may inflate only a short list of classes and a plain View is not among them. -->
    <FrameLayout
        android:id="@+id/widget_marker"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@color/marker" />

    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
